/* General application description */
"ApplicationDescription" = "MonitorControl به شما امکان می‌دهد روشنایی و صدای نمایشگرهای خارجی را کنترل کنید";

/* Sofware update deny consequences */
"SoftwareUpdateDenyConsequences" = "اگر این اتصالات را رد کنید، از نسخه‌های جدید و به‌روزرسانی‌های امنیتی مطلع نخواهید شد. به‌روزرسانی‌های امنیتی برای محافظت در برابر حملات بدافزار اهمیت دارند.";

/* Software update purpose */
"SoftwareUpdatePurpose" = "MonitorControl نسخه‌های جدید و به‌روزرسانی‌های امنیتی را بررسی می‌کند.";
